# Copy to .env. These defaults run everything locally (Homebrew Postgres or `docker compose up -d`).
# For the shared Supabase database, ask the team for its URL and set DB_SSL=true. Never commit .env.
DATABASE_URL=postgres://libraflow:libraflow@localhost:5432/libraflow_dev
DB_SSL=false

SHARED_SERVICE_API_KEY=

REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3000

# Auth & Users (the app refuses to start if these are missing or weak)
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Optional; these are the defaults
JWT_ACCESS_TTL=15m
REFRESH_IDLE_TTL=7d
REFRESH_ABSOLUTE_TTL_MEMBER=30d
REFRESH_ABSOLUTE_TTL_STAFF=12h
DEPOSIT_AMOUNT=5
LIBRARY_TIME_ZONE=Asia/Phnom_Penh

# First admin, for `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# Observability: JSON log lines with trace ids, and an optional OTLP endpoint
# (http://localhost:4318/v1/traces for Jaeger from `docker compose --profile observability up -d`)
LOG_FILE=logs/app.log
OTEL_SERVICE_NAME=libraflow-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
