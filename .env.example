# Copy to .env and fill in. Never commit .env.

# Database (Supabase connection string; see docs/context/tech-stack.md)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Space Booking integration
SHARED_SERVICE_API_KEY=change-me

# Auth & Users module (the app refuses to start if these are missing or weak)
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Optional; these are the defaults
JWT_ACCESS_TTL=15m
REFRESH_IDLE_TTL=7d
REFRESH_ABSOLUTE_TTL_MEMBER=30d
REFRESH_ABSOLUTE_TTL_STAFF=12h
DEPOSIT_AMOUNT=5
LIBRARY_TIME_ZONE=Asia/Phnom_Penh

# Used only by the seed script (npm run seed:admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
