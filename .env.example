# Server
PORT=3000

# PostgreSQL (Supabase) connection string
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Auth
JWT_SECRET=change-me
SHARED_SERVICE_API_KEY=change-me

# Redis (BullMQ)
# Use "localhost" when running the app with npm; docker compose overrides this to "redis"
REDIS_HOST=localhost
REDIS_PORT=6379
