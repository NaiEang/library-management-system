# Copy to .env. These defaults run everything locally (Homebrew Postgres or `docker compose up -d`).
# For the shared Supabase database, ask the team for its URL and set DB_SSL=true. Never commit .env.
DATABASE_URL=postgres://libraflow:libraflow@localhost:5432/libraflow_dev
DB_SSL=false

SHARED_SERVICE_API_KEY=

# ---- Redis / BullMQ (background jobs) ----
REDIS_HOST="localhost"
REDIS_PORT=6379
# Redis key prefix for the queues; leave as is (the E2E tests use their own)
BULLMQ_PREFIX=bull

# ---- Overdue notifications (docs/testing-overdue-notifications.md) ----
# Daily scan in LIBRARY_TIME_ZONE: marks late loan items overdue and queues one
# reminder per item. Cron format "min hour day month weekday"; "off" disables it
# (POST /notifications/overdue/scan still works).
OVERDUE_SCAN_CRON="0 8 * * *"

# Queue dashboard at http://localhost:3000/queues (the browser asks for this login).
# Empty password = dashboard off (404). Use a strong password outside your machine.
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=1234

# Email for reminders. Empty SMTP_HOST = reminders are saved in-app and only logged.
# Example (Gmail with an app password): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LibraFlow <no-reply@libraflow.local>"

PORT=3000

# Auth & Users: the app refuses to start if JWT_ACCESS_SECRET is missing or weak
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
# Optional; these are the defaults
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_TTL=15m
REFRESH_IDLE_TTL=7d
REFRESH_ABSOLUTE_TTL_MEMBER=30d
REFRESH_ABSOLUTE_TTL_STAFF=12h
DEPOSIT_AMOUNT=5
LIBRARY_TIME_ZONE=Asia/Phnom_Penh
# Optional switch, off by default: limits member sign-up to these email domains
# (comma-separated, e.g. itc.edu.kh). Empty = anyone can join. Staff accounts
# are never restricted.
MEMBER_EMAIL_DOMAINS=

# First admin, for `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# Observability: JSON log lines with trace ids, and an optional OTLP endpoint
# (http://localhost:4318/v1/traces for Jaeger from `docker compose --profile observability up -d`)
LOG_FILE=logs/app.log
OTEL_SERVICE_NAME=libraflow-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
